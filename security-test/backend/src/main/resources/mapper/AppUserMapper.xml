<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.asseterp.security.biz.user.mapper.AppUserMapper">

    <select id="findByUsername" resultType="com.asseterp.security.biz.user.entity.AppUser">
        SELECT
            user_id,
            company_id,
            username,
            password,
            full_name,
            role,
            created_at
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="findById" resultType="com.asseterp.security.biz.user.entity.AppUser">
        SELECT
            user_id,
            company_id,
            username,
            password,
            full_name,
            role,
            created_at
        FROM app_user
        WHERE user_id = #{userId}
    </select>

</mapper>
