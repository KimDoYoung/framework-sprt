<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- AS-IS sys01_company 매퍼(sys01_company.selectByCompanyCode)와 같은 조건 -->
<mapper namespace="kr.co.kfs.asseterp.oms.biz.company.mapper.CompanyMapper">

    <sql id="columns">
        sys01_company_id AS company_id,
        sys01_loc_nm     AS company_code,
        sys01_company_nm AS company_name,
        sys01_use_yn     AS use_yn
    </sql>

    <select id="findByCompanyCode" resultType="kr.co.kfs.asseterp.oms.biz.company.dto.CompanyRes">
        SELECT <include refid="columns"/>
        FROM sys01_company
        WHERE sys01_loc_nm = #{companyCode}
    </select>

    <select id="findAllUsable" resultType="kr.co.kfs.asseterp.oms.biz.company.dto.CompanyRes">
        SELECT <include refid="columns"/>
        FROM sys01_company
        WHERE sys01_use_yn = 'true'
        ORDER BY sys01_company_id
    </select>

</mapper>
