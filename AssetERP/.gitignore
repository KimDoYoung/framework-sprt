# ==========================================
# Root .gitignore for AssetERP Project
# ==========================================

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Build Outputs ──
dist/
dist-ssr/
*.local
*.tsbuildinfo
build/
out/
bin/
/backend/src/main/resources/static/*
!/backend/src/main/resources/static/.gitkeep

# ── Environment Variables ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Gradle ──
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ── IDE & Editor ──
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# ── OS & Temp Files ──
.DS_Store
Thumbs.db
*.swp
*.kate-swp
*~

# 파일 업로드·RD 시뮬레이터 시험용 샘플 파일 모음(사용자 관리, 커밋하지 않음)
data/samples/

# A-Man 매뉴얼 zip 샘플(6-매뉴얼 규격 확인용, 사용자 관리, 커밋하지 않음)
data/aman-samples/

# 매뉴얼 작업(6-매뉴얼)의 산출물 작업 폴더 — 확정본은 A-Man이 보관한다. 우리는 만들어 올리기만 함(커밋하지 않음)
/manual/

# DB 백업(tools/db_dump_backup.sh) — 크고 다시 받을 수 있음, 커밋하지 않는다
data/backup/

# 정적분석(tools/code-health.sh) 원본 결과 — 매번 덮어씀
docs/5-테스트/정적분석/raw/
__pycache__/
