<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- code-health Checkstyle: 들여쓰기·Javadoc 같은 스타일 소음은 넣지 않고 TOBE 규칙(docs/TOBE-Framework.md)과
     읽기 어려운 코드만 본다. id 가 report.py 의 규칙 이름이 된다. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- TOBE: @Setter / @Data 금지 (TOBE-Framework.md "금지") -->
    <module name="RegexpSingleline">
        <property name="id" value="TobeLombokSetterData"/>
        <property name="format" value="^\s*@(lombok\.)?(Setter|Data)\b"/>
        <property name="message" value="TOBE 규칙: @Setter/@Data 금지 — record 또는 @Getter+@Builder"/>
        <property name="fileExtensions" value="java"/>
    </module>
    <!-- TOBE: base package 는 kr.co.kfs.asseterp (com.asseterp 금지) -->
    <module name="RegexpSingleline">
        <property name="id" value="TobeComAsseterp"/>
        <property name="format" value="^\s*(package|import)\s+(static\s+)?com\.asseterp\b"/>
        <property name="message" value="TOBE 규칙: com.asseterp 패키지 금지 — kr.co.kfs.asseterp"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <module name="TreeWalker">
        <module name="MethodLength">
            <property name="max" value="200"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="10"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="PackageName">
            <property name="format" value="^kr\.co\.kfs\.asseterp(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
    </module>
</module>
